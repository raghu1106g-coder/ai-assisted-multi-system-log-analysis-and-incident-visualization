# ============================================================
# PS3 Log Analyzer — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Gemini API ---
# Required for AI narrative generation
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for narrative generation
GEMINI_MODEL=gemini-2.5-flash

# Maximum tokens for LLM context (keep bounded!)
GEMINI_MAX_TOKENS=8192

# Timeout for LLM requests in seconds
GEMINI_TIMEOUT_SECONDS=30

# --- Database ---
# DuckDB file path (relative to backend directory)
DUCKDB_PATH=./ps3_analysis.db

# --- Ingestion ---
# Root path to raw log files
DATA_ROOT=../data/synthetic

# Maximum file size to ingest (bytes) — prevents accidental huge file ingestion
MAX_FILE_SIZE_BYTES=104857600

# --- Correlation ---
# Temporal proximity window for TEMPORAL relationships (seconds)
TEMPORAL_WINDOW_SECONDS=10

# --- Application ---
# FastAPI host/port
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to true only during development
DEBUG=false
